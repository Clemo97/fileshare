# Copy this file to .env.local (it is gitignored) and fill it in.
# Without both values the app runs as the offline UI preview on sample data.
#
# Both values are public by design and end up readable inside the built app. Use the project's
# URL and its anon (or "publishable") key. Never put the service-role key here.
#
# They are inlined when the JavaScript is bundled, so rebuild after changing them.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
