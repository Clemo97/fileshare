{
  "expo": {
    "name": "Acornet",
    "slug": "acornet",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "io.github.clemo97.acornet",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Lets this app find and connect directly to your other devices on the same Wi-Fi network to send files.",
        "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.clemo97.acornet"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "This app never uses the camera. The text is required because the networking library it uses for device-to-device transfers can capture video.",
          "microphonePermission": "This app never uses the microphone. The text is required because the networking library it uses for device-to-device transfers can capture audio."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4fac8254-8d2a-4085-b013-9feda03a8f3b"
      }
    },
    "owner": "clementlumumba"
  }
}
